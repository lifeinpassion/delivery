{
  "name": "courier-driver-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "ulimit -n 65536 2>/dev/null || true && expo start",
    "start:clear": "ulimit -n 65536 2>/dev/null || true && expo start --clear",
    "start:tunnel": "ulimit -n 65536 2>/dev/null || true && expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "~3.29.0",
    "react-native-safe-area-context": "4.8.2",
    "axios": "^1.6.2",
    "socket.io-client": "^4.6.1",
    "expo-location": "~16.5.3",
    "react-native-maps": "1.10.0",
    "expo-camera": "~14.0.5",
    "expo-image-picker": "~14.7.1",
    "@react-native-async-storage/async-storage": "1.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@types/react": "~18.2.45",
    "typescript": "^5.3.3"
  },
  "private": true
}
